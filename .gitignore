# ============================================================
# VascGuide AI Agent — .gitignore
# Python 模板
# ============================================================

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---- Build / packaging ----
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/
# 注意：.python-version 用于锁定并共享解释器版本（3.13.14），故不忽略、需入库。

# ---- Environment variables & secrets ----
.env
.env.*
*.env
secrets.*
!.env.example

# ---- Testing / linting / type-check caches ----
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
pytest-cache-files-*/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Local agent workspace (记忆/会话态) ----
.workbuddy/

# ---- Local data / artifacts (按需保留目录结构) ----
*.log
.DS_Store

# ---- 病例目录：只入库示例病例 ----
# cases/ 下的真实病例（CASE-01~08、CASE-ZS-01~09）含患者信息，
# 分析文档（GAP/GATE/ACTION-PLAN 等）与假设层均为本地工作产物，
# 一律不入版本库；仅 emergency.json 与 example.json 两个示例入库。
cases/*
!cases/emergency.json
!cases/example.json
